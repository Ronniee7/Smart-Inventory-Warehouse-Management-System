# StockPilot environment variables (example)
# Copy to .env and fill in real values. Never commit real .env files.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://stockpilot:change-me@localhost:5432/stockpilot

# CORS / CSRF (optional overrides)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production security (optional overrides)
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Redis / Celery (optional, later phases)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api
